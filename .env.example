# Copy this file to .env and fill in your local values.
# .env is git-ignored — never commit real credentials.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/e-commerce-website
APP_TIMEZONE=Asia/Karachi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopmate
DB_USER=root
DB_PASS=

# --- Email (SMTP) ---
# DUMMY PLACEHOLDER VALUES — replace with your real SMTP provider before
# order confirmation emails will actually send. See README "Email setup"
# section for how to get a Gmail App Password (or use Mailtrap for local
# testing without a real inbox).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=youremail@gmail.com
MAIL_FROM_NAME="ShopMate Pakistan"
